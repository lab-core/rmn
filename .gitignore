__pycache__/
.DS_Store
# the generated cover page and the directory the server builds it in --
# not the source that builds them, which this used to swallow whole
templates/front_page.pdf
services/server/front_page_temp/
.idea/**
venv*/

# debug crops the recogniser writes beside itself when imaging.ignoreWrite is
# false -- which a coverage run makes it, because that sets a trace function
images/
numbers/
*.egg-info/

# real graded copies and their notes, used to measure the grade reader:
# student names, matricules, e-mail addresses and grades. Only the redacted
# fixtures under services/executor/tests/fixtures/ink_grades belong in the
# repository.
examples/
notes*.csv

# Local secrets — never commit
.env
services/server/slack_token
deployment/secrets.yml

# throwaway kustomize overlay created by scripts/deploy.sh
.deploy-overlay.*/

# local runtime data and build output
storage/
node_modules/
.angular/
services/executor/tmp_*/
services/server/temp/

# Angular build output
services/webapp/ng/dist/

# test artefacts
coverage/
.coverage
.coverage.*
services/*/tests/_storage/
