# Build context is services/: keep this service and the shared package only.
# (BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile.)
*
!common/
!executor/
common/tests/
common/*.egg-info/
**/__pycache__/
**/.pytest_cache/
executor/venv*/
executor/tmp_*/
executor/tests/
executor/images/
executor/test.py
executor/requirements.old.txt
executor/README.md
executor/Dockerfile*
# the Keras model and the training data stay out of the image: it runs the .tflite
executor/digit_recognizer.h5
executor/models/
executor/python/process_copy/train.py
executor/python/process_copy/export_tflite.py
executor/requirements-train.txt
