# Local docker-compose secrets. Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — NEVER commit real secrets.

# MongoDB root credentials. Used by the mongo container (at first init) and by
# the server/executor to authenticate. NOTE: on an existing ./storage/mongo
# volume the password is fixed at the value used when the volume was created;
# to change it, rotate it inside mongo (db.changeUserPassword) and update here.
MONGODB_USER=adminuser
MONGODB_PASSWORD=change-me

# Password every Redis client must send. Redis previously ran with no auth.
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=change-me

# Shared secret guarding the /admin/* operator endpoints. Empty => those
# endpoints are disabled (fail closed). Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# Slack bot token for the health-check pings (optional). Leave empty to disable.
SLACK_TOKEN=
